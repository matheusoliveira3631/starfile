PORT=3000
LOG_LEVEL=info

AWS_REGION=us-east-1
# LocalStack. Remova para usar a AWS de verdade.
AWS_ENDPOINT_URL=http://localhost:4566
BUCKET_NAME=starfile-dev
TABLE_NAME=starfile-dev

MAX_UPLOAD_MB=25
UPLOAD_URL_TTL_SECONDS=300

PUBLIC_BASE_URL=http://localhost:3000
FILE_RETENTION_DAYS=30
LINK_MAX_TTL_HOURS=168
DOWNLOAD_URL_TTL_SECONDS=60

TRUST_PROXY=false
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_UPLOADS_PER_HOUR=50
RATE_LIMIT_DOWNLOADS_PER_MINUTE=60
RATE_LIMIT_AUTH_FAILURES_PER_MINUTE=20
